<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_dog_pension_stay" model="ir.sequence">
            <field name="name">Dog Pension Stay</field>
            <field name="code">dog.pension.stay</field>
            <field name="prefix">STAY/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="product_dog_pension_stay" model="product.product">
            <field name="name">Dog Pension Stay (per day)</field>
            <field name="type">service</field>
            <field name="is_dog_pension_service" eval="True"/>
            <field name="dog_pension_daily_rate">25.0</field>
            <field name="list_price">25.0</field>
            <field name="uom_id" ref="uom.product_uom_day"/>
        </record>
    </data>
</odoo>
