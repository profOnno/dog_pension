<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- LIST VIEW                                                      -->
    <!-- ============================================================= -->
    <record id="view_dog_pension_dog_list" model="ir.ui.view">
        <field name="name">dog.pension.dog.list</field>
        <field name="model">dog.pension.dog</field>
        <field name="arch" type="xml">
            <list string="Dogs"
                  decoration-success="is_boarding"
                  decoration-muted="not is_boarding and not active">
                <field name="image_1920" widget="image"
                       options="{'zoom': True, 'preview_image':'image_128', 'size': [40, 40]}"/>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="breed_id"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="weight"/>
                <field name="is_boarding" invisible="1"/>
                <field name="active" invisible="1"/>
                <field name="stay_count"/>
            </list>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- FORM VIEW                                                      -->
    <!-- ============================================================= -->
    <record id="view_dog_pension_dog_form" model="ir.ui.view">
        <field name="name">dog.pension.dog.form</field>
        <field name="model">dog.pension.dog</field>
        <field name="arch" type="xml">
            <form string="Dog">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                        bg_color="text-bg-danger" invisible="active"/>

                    <div class="d-flex flex-column flex-md-row align-items-start justify-content-md-between">
                        <div class="oe_title flex-grow-1">
                            <h1><field name="name" placeholder="Dog Name"/></h1>
                        </div>
                        <div class="d-flex align-items-start mt-2 mt-md-0 ms-md-3">
                            <field name="image_1920" widget="image" class="oe_avatar"
                                  options="{'preview_image': 'image_128', 'zoom': True}"/>
                            <button name="action_show_photo_fullscreen"
                                    type="object"
                                    class="btn btn-link p-0 ms-1"
                                    icon="fa-expand"
                                    title="View Photo"
                                    aria-label="View Photo"
                                    invisible="not image_1920"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="owner_id"/>
                            <field name="breed_id"/>
                            <field name="gender"/>
                            <field name="color"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="weight"/>
                            <field name="is_sterilized"/>
                            <field name="microchip"/>
                            <field name="vaccination_date"/>
                            <field name="vet_name"/>
                            <field name="vet_phone"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <group string="Current Location" invisible="not is_boarding">
                        <group>
                            <field name="current_kennel_id"/>
                            <field name="current_hallway_id"/>
                        </group>
                        <group>
                            <field name="current_room_id"/>
                            <field name="is_boarding" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="QR Code">
                            <group>
                                <field name="qr_code" widget="image"
                                      options="{'size': [200, 200]}"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional information..."/>
                        </page>
                        <page string="Stays">
                            <field name="stay_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="duration_days"/>
                                    <field name="state" widget="badge"
                                          decoration-info="state == 'draft'"
                                          decoration-success="state in ('confirmed', 'in_progress')"
                                          decoration-muted="state in ('done', 'cancelled')"/>
                                    <field name="sale_order_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dog_pension_dog_photo_fullscreen" model="ir.ui.view">
        <field name="name">dog.pension.dog.photo.fullscreen</field>
        <field name="model">dog.pension.dog</field>
        <field name="arch" type="xml">
            <form string="Photo" create="false" edit="false">
                <sheet>
                    <field name="image_1920" widget="image" readonly="1"
                          options="{'zoom': False}"/>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- SEARCH VIEW                                                    -->
    <!-- ============================================================= -->
    <record id="view_dog_pension_dog_search" model="ir.ui.view">
        <field name="name">dog.pension.dog.search</field>
        <field name="model">dog.pension.dog</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="breed_id"/>
                <field name="current_kennel_id"/>
                <filter name="boarding" string="Currently Boarding"
                        domain="[('is_boarding', '=', True)]"/>
                <filter name="not_boarding" string="Not Boarding"
                        domain="[('is_boarding', '=', False)]"/>
                <separator/>
                <filter name="inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_owner" string="Owner"
                            context="{'group_by': 'owner_id'}"/>
                    <filter name="group_breed" string="Breed"
                            context="{'group_by': 'breed_id'}"/>
                    <filter name="group_gender" string="Gender"
                            context="{'group_by': 'gender'}"/>
                    <filter name="group_kennel" string="Current Kennel"
                            context="{'group_by': 'current_kennel_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- BREED VIEWS                                                    -->
    <!-- ============================================================= -->
    <record id="view_dog_pension_breed_list" model="ir.ui.view">
        <field name="name">dog.pension.breed.list</field>
        <field name="model">dog.pension.breed</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_dog_pension_breed_form" model="ir.ui.view">
        <field name="name">dog.pension.breed.form</field>
        <field name="model">dog.pension.breed</field>
        <field name="arch" type="xml">
            <form string="Breed">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Breed name"/></h1>
                    </div>
                    <group>
                        <field name="description" placeholder="Description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- ACTIONS                                                        -->
    <!-- ============================================================= -->
    <record id="action_dog_pension_dog" model="ir.actions.act_window">
        <field name="name">Dogs</field>
        <field name="res_model">dog.pension.dog</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_dog_pension_dog_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first dog</p>
        </field>
    </record>

    <record id="action_dog_pension_breed" model="ir.actions.act_window">
        <field name="name">Breeds</field>
        <field name="res_model">dog.pension.breed</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
