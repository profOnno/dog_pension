<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dog_quick_create_form" model="ir.ui.view">
        <field name="name">dog.pension.dog.quick.create.form</field>
        <field name="model">dog.pension.dog.quick.create</field>
        <field name="arch" type="xml">
            <form string="New Dog">
                <group>
                    <group>
                        <field name="name" placeholder="e.g. Max"/>
                        <field name="owner_id" readonly="1"/>
                        <field name="breed_id"/>
                        <field name="gender"/>
                    </group>
                    <group>
                        <field name="birth_date"/>
                        <field name="weight"/>
                        <field name="microchip"/>
                    </group>
                </group>
                <group>
                    <field name="notes" placeholder="Any additional information..."/>
                </group>
                <field name="line_id" invisible="1"/>
                <footer>
                    <button name="action_create_and_select"
                            string="Create Dog"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dog_quick_create" model="ir.actions.act_window">
        <field name="name">New Dog</field>
        <field name="res_model">dog.pension.dog.quick.create</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_dog_quick_create_form"/>
    </record>

</odoo>
