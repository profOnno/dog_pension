<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- LIST VIEW                                                      -->
    <!-- ============================================================= -->
    <record id="view_kennel_list" model="ir.ui.view">
        <field name="name">dog.pension.kennel.list</field>
        <field name="model">dog.pension.kennel</field>
        <field name="arch" type="xml">
            <list string="Kennels"
                  decoration-success="state == 'available' and occupancy_state == 'empty'"
                  decoration-info="state == 'available' and occupancy_state == 'partial'"
                  decoration-warning="state == 'available' and occupancy_state == 'full'"
                  decoration-muted="state in ('maintenance', 'blocked')">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="hallway_id"/>
                <field name="room_id" optional="hide"/>
                <field name="size"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'maintenance'"
                       decoration-danger="state == 'blocked'"/>
                <field name="current_occupancy" string="In Use"/>
                <field name="capacity"/>
                <field name="occupancy_state" widget="badge"
                       decoration-muted="occupancy_state == 'empty'"
                       decoration-info="occupancy_state == 'partial'"
                       decoration-warning="occupancy_state == 'full'"/>
                <field name="current_dogs_label" string="Current Dog(s)"/>
            </list>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- FORM VIEW                                                      -->
    <!-- ============================================================= -->
    <record id="view_kennel_form" model="ir.ui.view">
        <field name="name">dog.pension.kennel.form</field>
        <field name="model">dog.pension.kennel</field>
        <field name="arch" type="xml">
            <form string="Kennel">
                <header>
                    <button name="action_set_available"
                            type="object"
                            string="Set Available"
                            class="btn-primary"
                            invisible="state == 'available'"/>
                    <button name="action_set_maintenance"
                            type="object"
                            string="Set Maintenance"
                            invisible="state == 'maintenance'"/>
                    <button name="action_set_blocked"
                            type="object"
                            string="Block"
                            invisible="state == 'blocked'"/>
                    <button name="%(action_report_kennel_qr_label)d"
                            type="action"
                            string="Print QR Label"
                            class="btn-secondary"
                            icon="fa-print"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,maintenance,blocked"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Label, e.g. A-01"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="hallway_id"/>
                            <field name="room_id"/>
                            <field name="sequence"/>
                            <field name="size"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="current_occupancy"/>
                            <field name="occupancy_state" widget="badge"
                                   decoration-muted="occupancy_state == 'empty'"
                                   decoration-info="occupancy_state == 'partial'"
                                   decoration-warning="occupancy_state == 'full'"/>
                            <field name="has_outdoor_access"/>
                            <field name="has_heating"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Current Occupants">
                        <field name="current_dogs_html" widget="html" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="QR Code">
                            <group>
                                <field name="qr_code" widget="image"
                                       options="{'size': [200, 200]}"/>
                            </group>
                        </page>
                        <page string="Assignment History">
                          <field name="stay_kennel_ids" readonly="1" create="false" edit="false">
                            <list create="false" edit="false" delete="false"
                              open_form_view="false">
                              <field name="stay_id"/>
                              <field name="dog_id"/>
                              <field name="start_date"/>
                              <field name="end_date"/>
                              <field name="duration_days"/>
                            </list>
                          </field>
                        </page> 
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- SEARCH VIEW                                                    -->
    <!-- ============================================================= -->
    <record id="view_kennel_search" model="ir.ui.view">
        <field name="name">dog.pension.kennel.search</field>
        <field name="model">dog.pension.kennel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="hallway_id"/>
                <field name="room_id"/>
                <filter name="available" string="Available"
                        domain="[('state', '=', 'available')]"/>
                <filter name="empty" string="Empty"
                        domain="[('occupancy_state', '=', 'empty')]"/>
                <filter name="partial" string="Partial"
                        domain="[('occupancy_state', '=', 'partial')]"/>
                <filter name="full" string="Full"
                        domain="[('occupancy_state', '=', 'full')]"/>
                <filter name="maintenance" string="Maintenance"
                        domain="[('state', '=', 'maintenance')]"/>
                <filter name="blocked" string="Blocked"
                        domain="[('state', '=', 'blocked')]"/>
                <group>
                    <filter name="group_room" string="Room"
                            context="{'group_by': 'room_id'}"/>
                    <filter name="group_hallway" string="Hallway"
                            context="{'group_by': 'hallway_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_occupancy" string="Occupancy"
                            context="{'group_by': 'occupancy_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- ACTION                                                         -->
    <!-- ============================================================= -->
    <record id="action_kennel" model="ir.actions.act_window">
        <field name="name">Kennels</field>
        <field name="res_model">dog.pension.kennel</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kennel_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first kennel</p>
        </field>
    </record>

</odoo>
