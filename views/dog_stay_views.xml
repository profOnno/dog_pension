<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dog_pension_stay_tree" model="ir.ui.view">
        <field name="name">dog.pension.stay.tree</field>
        <field name="model">dog.pension.stay</field>
        <field name="arch" type="xml">
          <list string="Dog Stays"
              decoration-success="state == 'in_progress'"
              decoration-info="state == 'confirmed'"
              decoration-muted="state in ('done', 'cancelled')">        
                <field name="name"/>
                <field name="dog_id"/>
                <field name="owner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration_days"/>
                <field name="current_kennel_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'in_progress'"
                       decoration-muted="state in ('done','cancelled')"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="view_dog_pension_stay_form" model="ir.ui.view">
        <field name="name">dog.pension.stay.form</field>
        <field name="model">dog.pension.stay</field>
        <field name="arch" type="xml">
            <form string="Dog Stay">
               <sheet>
                    <header>
                        <button name="action_confirm" type="object" string="Confirm"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_start" type="object" string="Start Stay"
                                class="btn-primary" invisible="state != 'confirmed'"/>
                        <button name="action_done" type="object" string="Finish"
                                class="btn-primary" invisible="state != 'in_progress'"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state in ('done', 'cancelled')"/>
                        <button name="action_reset_draft" type="object" string="Reset to Draft"
                                invisible="state == 'draft'"/>
                        <button name="%(action_report_kennel_card)d"
                                type="action"
                                string="Print Kennel Card"
                                class="btn-secondary"
                                icon="fa-print"
                                invisible="state not in ('confirmed', 'in_progress')"/>
                        <field name="state" widget="statusbar"
                              statusbar_visible="draft,confirmed,in_progress,done"/>
                    </header>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="dog_id"/>
                            <field name="owner_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_days"/>
                        </group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="sale_order_line_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="food_provided"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Care Instructions">
                            <group>
                                <field name="special_needs" placeholder="Dietary or behavioral needs..."/>
                                <field name="medication" placeholder="Medication to administer..."/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
			<page string="Kennel Assignments">
			    <group>
				<group>
				    <field name="current_kennel_id"/>
				    <field name="room_id"/>
				    <field name="hallway_id"/>
				</group>
			    </group>
              <field name="kennel_assignment_ids"
                     context="{'default_stay_id': id}">
				<list editable="bottom">
				    <field name="kennel_id"
					   domain="[('state', 'in', ('available', 'occupied'))]"/>
				    <field name="start_date"/>
				    <field name="end_date"/>
				    <field name="duration_days"/>
				    <field name="notes"/>
				</list>
			    </field>
			</page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dog_pension_stay_search" model="ir.ui.view">
        <field name="name">dog.pension.stay.search</field>
        <field name="model">dog.pension.stay</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="dog_id"/>
                <field name="owner_id"/>
                <field name="sale_order_id"/>
                <filter name="filter_in_progress" string="In Progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_today" string="Starting Today"
                        domain="[('start_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('start_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <group>
                    <filter name="group_dog" string="Dog" context="{'group_by': 'dog_id'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dog_pension_stay_calendar" model="ir.ui.view">
        <field name="name">dog.pension.stay.calendar</field>
        <field name="model">dog.pension.stay</field>
        <field name="arch" type="xml">
            <calendar string="Dog Stays" date_start="start_date" date_stop="end_date"
                      color="dog_id" mode="month">
                <field name="name"/>
                <field name="dog_id"/>
                <field name="owner_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_dog_pension_stay" model="ir.actions.act_window">
        <field name="name">Dog Stays</field>
        <field name="res_model">dog.pension.stay</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first dog stay</p>
        </field>
    </record>

</odoo>
