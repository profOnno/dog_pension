<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_room_list" model="ir.ui.view">
        <field name="name">dog.pension.room.list</field>
        <field name="model">dog.pension.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="name"/>
                <field name="code"/>
                <field name="hallway_count"/>
                <field name="kennel_count"/>
            </list>
        </field>
    </record>

    <record id="view_room_form" model="ir.ui.view">
        <field name="name">dog.pension.room.form</field>
        <field name="model">dog.pension.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Room name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="hallway_count"/>
                            <field name="kennel_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hallways">
                            <field name="hallway_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="kennel_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">dog.pension.room</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
